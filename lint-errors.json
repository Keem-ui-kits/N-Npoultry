Z(i, x, y, z);\n        }\n      }\n\n      geo.computeVertexNormals();\n      return geo;\n    } catch (e) {\n      console.error('Failed to create egg geometry:', e);\n      return new THREE.SphereGeometry(1.6, 32, 32);\n    }\n  }, []);\n\n  useEffect(() => {\n    return () => {\n      geometry.dispose();\n    };\n  }, [geometry]);\n\n  return (\n    <mesh castShadow geometry={geometry}>\n      <meshPhysicalMaterial\n        color=\"#c86d38\"\n        roughness={0.5}\n        metalness={0.05}\n        clearcoat={0.2}\n        clearcoatRoughness={0.3}\n      />\n    </mesh>\n  );\n}\n\nexport function FloatingEgg3DScene() {\n  return (\n    <div className=\"w-full h-[350px] md:h-[750px] relative pointer-events-none md:pointer-events-auto overflow-hidden\">\n      <Suspense fallback={<div className=\"w-full h-full bg-transparent flex items-center justify-center text-muted-foreground/20\">Loading...</div>}>\n        <Canvas\n          shadows\n          camera={{ fov: 45, position: [0, 0, 5.5] }}\n          gl={{\n            antialias: true,\n            alpha: true,\n            depth: true,\n            powerPreference: 'default'\n          }}\n          // Use dynamic dpr but cap it at 2 for mobile stability\n          dpr={typeof window !== 'undefined' ? Math.min(window.devicePixelRatio, 2) : 1}\n        >\n          <CameraController />\n          <ambientLight intensity={1.2} color=\"#ffe8d6\" />\n\n          <directionalLight\n            position={[-5, 5, 5]}\n            intensity={2.8}\n            castShadow\n            shadow-mapSize={[512, 512]} // Reduced resolution for stability\n          />\n\n          <pointLight position={[5, -5, 5]} intensity={1.5} color=\"#ffedd6\" />\n          \n          <PresentationControls\n            global\n            snap\n            rotation={[0, 0, 0]}\n            polar={[-0.2, 0.2]}\n            azimuth={[-0.3, 0.3]}\n          >\n            <Float\n              speed={1.2}\n              rotationIntensity={0.2}\n              floatIntensity={0.8}\n              floatingRange={[-0.15, 0.15]}\n            >\n              <EggMesh />\n            </Float>\n          </PresentationControls>\n\n          <Environment preset=\"city\" />\n\n          <ContactShadows\n            position={[0, -2.8, 0]}\n            opacity={0.4}\n            scale={7}\n            blur={2.5}\n            far={4}\n            color=\"#000000\"\n          />\n\n        </Canvas>\n      </Suspense>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\ui\\hero-section-9.tsx","messages":[{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":127,"column":30,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":127,"endColumn":32,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[4254,4256],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":142,"column":30,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":142,"endColumn":32,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[5255,5257],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":156,"column":30,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":156,"endColumn":32,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[6230,6232],"text":"??"},"desc":"Fix to nullish coalescing operator 
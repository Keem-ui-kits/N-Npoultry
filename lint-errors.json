row items-center justify-start sm:justify-center overflow-x-auto gap-4 sm:gap-8 md:gap-16 px-4 hide-scrollbar\">\r\n          {categories.map((cat) => (\r\n            <button\r\n              key={cat.id}\r\n              onClick={() => { setActiveTab(cat.id); }}\r\n              title={cat.name}\r\n              className={cn(\r\n                \"text-xs md:text-lg lg:text-xl font-bold uppercase tracking-widest transition-all px-5 py-2 md:py-3 border rounded-full whitespace-nowrap overflow-hidden text-ellipsis\",\r\n                \"max-w-[110px] sm:max-w-[150px] md:max-w-none\", // Truncation constraints for mobile\r\n                activeTab === cat.id \r\n                  ? \"text-brand-dark bg-brand-gold border-brand-gold\" \r\n                  : \"text-white/50 border-white/20 bg-white/5 hover:border-white/50 hover:text-white/80 hover:bg-white/10\"\r\n              )}\r\n            >\r\n              {cat.name}\r\n            </button>\r\n          ))}\r\n        </div>\r\n      </section>\r\n\r\n      {/* Mini Page Content */}\r\n      <section className=\"py-20 px-4 md:px-8 max-w-7xl mx-auto relative z-10 min-h-[50vh]\">\r\n        {activeCategory && (\r\n          <div key={activeCategory.id} className=\"animate-in fade-in slide-in-from-bottom-8 duration-700\">\r\n            \r\n            {/* Category Header */}\r\n            <div className=\"mb-20 border-b border-white/10 pb-8 text-center max-w-4xl mx-auto\">\r\n              <h2 className=\"text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight\">{activeCategory.name}</h2>\r\n              <p className=\"text-xl md:text-2xl text-brand-gold/80 font-light\">{activeCategory.description}</p>\r\n            </div>\r\n\r\n            {/* Alternating Articles Layout */}\r\n            <div className=\"space-y-32\">\r\n              {activeArticles.map((article, idx) => {\r\n                // Zig-zag layout: even indexes (0) image left, odd indexes (1) image right\r\n                const isImageRight = idx % 2 !== 0;\r\n\r\n                return (\r\n                  <article \r\n                    key={article.id} \r\n                    className={cn(\r\n                      \"flex flex-col md:items-center gap-12 lg:gap-20 group\", \r\n                      isImageRight ? \"md:flex-row-reverse\" : \"md:flex-row\"\r\n                    )}\r\n                  >\r\n                    \r\n                    {/* Article Image */}\r\n                    <div className=\"relative w-full md:w-1/2 aspect-square lg:aspect-[4/3] rounded-3xl overflow-hidden border border-white/10 shadow-2xl\">\r\n                      <Image\r\n                        src={article.image}\r\n                        alt={article.title}\r\n                        fill\r\n                        className=\"object-cover group-hover:scale-105 transition-transform duration-700\"\r\n                        sizes=\"(max-width: 768px) 100vw, 50vw\"\r\n                      />\r\n                      <div className=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-50\" />\r\n                    </div>\r\n                    \r\n                    {/* Article Content */}\r\n                    <div className=\"w-full md:w-1/2 flex flex-col justify-center\">\r\n                      <h3 className=\"text-4xl md:text-5xl font-bold text-white mb-8 tracking-tight group-hover:text-brand-gold transition-colors\">\r\n                        {article.title}\r\n                      </h3>\r\n                      <div className=\"prose prose-invert prose-lg max-w-none text-white/70 font-light leading-relaxed\">\r\n                        {Array.isArray(article.content) ? (\r\n                          article.content.map((paragraph, pIdx) => (\r\n                            <p key={pIdx} className=\"mb-6\">{paragraph}</p>\r\n                          ))\r\n                        ) : (\r\n                          <p>{article.content as React.ReactNode}</p>\r\n                        )}\r\n                      </div>\r\n                    </div>\r\n\r\n                  </article>\r\n                );\r\n              })}\r\n            </div>\r\n          </div>\r\n        )}\r\n      </section>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\Hero.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\HowWeWork.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\HowWeWorkClientWrapper.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\ProductsTeaser.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\StepCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\Testimonials.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\TestimonialsCarousel.tsx","messages":[],"suppressedMe
 color: accentHex }}>{product.titleAccent}</span>\r\n          </h3>\r\n          <p className=\"text-base text-muted-foreground leading-relaxed\">\r\n            {product.fullDescription ?? product.description}\r\n          </p>\r\n          {product.features && product.features.length > 0 && (\r\n            <ul className=\"space-y-2 pt-1\">\r\n              {product.features.map((f, i) => (\r\n                <motion.li\r\n                  key={i}\r\n                  className=\"flex items-center gap-2.5 text-sm font-medium text-foreground/80\"\r\n                  initial={{ opacity: 0, x: -8 }}\r\n                  whileInView={{ opacity: 1, x: 0 }}\r\n                  viewport={{ once: true }}\r\n                  transition={{ duration: 0.35, delay: 0.15 + i * 0.06 }}\r\n                >\r\n                  <CheckCircle2 className=\"w-4 h-4 shrink-0\" style={{ color: accentHex }} />\r\n                  {f}\r\n                </motion.li>\r\n              ))}\r\n            </ul>\r\n          )}\r\n\r\n          {product.bestFor && product.bestFor.length > 0 && (\r\n            <div className=\"flex flex-wrap gap-1.5 pt-2\">\r\n              {product.bestFor.map((audience, i) => (\r\n                <span\r\n                  key={i}\r\n                  className=\"text-xs font-semibold px-2.5 py-0.5 rounded-full\"\r\n                  style={{ background: `${accentHex}10`, color: `${accentHex}cc`, border: `1px solid ${accentHex}25` }}\r\n                >\r\n                  {audience}\r\n                </span>\r\n              ))}\r\n            </div>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </motion.div>\r\n    </div>\r\n  );\r\n}\r\n\r\n// ─── Divider ─────────────────────────────────────────────────────────────────\r\nfunction ProductDivider({ color }: { color: string }) {\r\n  return (\r\n    <motion.div\r\n      className=\"relative flex items-center gap-4 py-2\"\r\n      initial={{ opacity: 0, scaleX: 0 }}\r\n      whileInView
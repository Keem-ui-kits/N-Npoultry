 mb-4 tracking-tight\">{item.title}</h3>\r\n                    <p className=\"text-white/50 text-lg md:text-xl lg:text-2xl leading-relaxed max-w-xl font-light\">{item.description}</p>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })}\r\n          </div>\r\n        </section>\r\n      </div>\r\n    </AboutClientWrapper>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\AboutClientWrapper.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\Contact.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-condition","severity":2,"message":"Unnecessary conditional, expected left-hand side of `??` operator to be possibly null or undefined.","line":24,"column":21,"nodeType":"CallExpression","messageId":"neverNullish","endLine":24,"endColumn":34},{"ruleId":"@typescript-eslint/no-unnecessary-condition","severity":2,"message":"Unnecessary conditional, expected left-hand side of `??` operator to be possibly null or undefined.","line":25,"column":22,"nodeType":"CallExpression","messageId":"neverNullish","endLine":25,"endColumn":36}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\r\nimport { motion } from 'framer-motion';\r\nimport { useInView } from 'framer-motion';\r\nimport { useRef, useState } from 'react';\r\nimport { Mail, MapPin, Phone, Send } from 'lucide-react';\r\nimport { useForm } from 'react-hook-form';\r\nimport { zodResolver } from '@hookform/resolvers/zod';\r\nimport { siteConfig } from '@/content/site';\r\nimport { contactSchema, type ContactFormData } from '@/lib/schemas/contact';\r\nimport { Input } from '@/components/ui/input';\r\n\r\nexport function Contact() {\r\n  const ref = useRef(null);\r\n  const isInView = useInView(ref, { once: true, amount: 0.3 });\r\n  const {\r\n    register,\r\n    handleSubmit,\r\n    reset,\r\n    setValue,\r\n    watch,\r\n    formState: { errors, isSubmitting },\r\n  } = useForm<ContactFormData>({ resolver: zodResolver(contactSchema) });\r\n\r\n  const nameValue = watch('name') ?? '';\r\n  const emailValue = watch('email') ?? '';\r\n  const websiteValue = watch('website') ?? '';\r\n\r\n  const [submitStatus, setSubmitStatus] = useState<'idle' | 'success' | 'error'>('idle');\r\n\r\n  const onSubmit = async (data: ContactFormData) => {\r\n    setSubmitStatus('idle');\r\n\r\n    try {\r\n      const res = await fetch('/api/contact', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify(data),\r\n      });\r\n\r\n      if (!res.ok) throw new Error('Failed');\r\n      setSubmitStatus('success');\r\n      reset();\r\n    } catch {\r\n      setSubmitStatus('error');\r\n    }\r\n  };\r\n\r\n  return (\r\n    <section\r\n      id=\"contact\"\r\n      ref={ref}\r\n      className=\"relative min-h-screen flex items-center justify-center py-16 md:py-24 overflow-hidden bg-gradient-to-b from-[#f8f9fa] to-white dark:from-muted/20 dark:to-background\"\r\n    >\r\n      <div className=\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full\">\r\n        <div className=\"bg-card dark:bg-brand-dark/80 border border-border dark:border-white/10 rounded-3xl p-6 md:p-12 lg:p-16 backdrop-blur-sm shadow-xl\">\r\n          <div className=\"grid lg:grid-cols-2 gap-8 md:gap-12\">\r\n            {/* Contact Info */}\r\n            <motion.div\r\n              initial={{ opacity: 0, x: -40 }}\r\n              animate={isInView ? { opacity: 1, x: 0 } : {}}\r\n              transition={{ duration: 0.6 }}\r\n            >\r\n              <div className=\"space-y-6 pt-2\">\r\n                <div>\r\n                  <h3 className=\"text-foreground dark:text-white font-bold text-lg md:text-xl mb-3 flex items-center gap-3\">\r\n                    <Mail className=\"w-6 h-6 text-brand-gold\" />\r\n                    Open a business account\r\n                  </h3>\r\n                  <p className=\"text-muted-foreground dark:text-white/50 text-sm md:text-base pl-9\">\r\n                    For planning and logistics, fill the call card. Terms apply\r\n                  </p>\r\n                </div>\r\n\r\n                <div>\r\n                  <h3 className=\"text-foreground dark:text-white font-bold text-lg md:text-xl mb-3 flex items-center gap-3\">\r\n                    <MapPin className=\"w-6 h-6 text-brand-gold\" />\r\n                    Business Hours\r\n                  </h3>\r\n                  <p className=\"text-muted-foreground dark:text-white/50 text-sm md:text-base pl-9\">\r\n                    {siteConfig.businessHours.weekdays}\r\n                    <br />\r\n                    {siteConfig.businessHours.saturday}\r\n                  </p>\r\n                </div>\r\n\r\n                <div>\r\n                  <h3 className=\"text-foreground dark:text-white font-bold text-lg md:text-xl mb-3 flex items-center gap-3\">\r\n                    <Phone className=\"w-6 h-6 text-brand-gold\" />\r\n                    Phone\r\n                  </h3>\r\n                  <p className=\"text-muted-foreground dark:text-white/50 text-sm md:text-base pl-9\">\r\n                    {siteConfig.contacts.phones.join(' / ')}\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </motion.div>\r\n\r\n            {/* Contact Form */}\r\n            <motion.form\r\n              onSubmit={(e) => { void handleSubmit(onSubmit)(e); }}\r\n              initial={{ opacity: 0, x: 40 }}\r\n              animate={isInView ? { opacity: 1, x: 0 } : {}}\r\n              transition={{ duration: 0.6, delay: 0.2 }}\r\n              className=\"space-y-6\"\r\n            >\r\n              <div>\r\n                <Input\r\n                  id=\"name\"\r\n                  label=\"Name *\"\r\n                  value={nameValue}\r\n                  {...register('name')}\r\n                  onChange={(e) => { setValue('name', e.target.value, { shouldValidate: true }); }}\r\n                  className=\"w-full\"\r\n                />\r\n                {errors.name && <p className=\"text-destructive text-sm mt-1\">{errors.name.message}</p>}\r\n              </div>\r\n\r\n              <div>\r\n                <Input\r\n                  id=\"email\"\r\n                  label=\"Email *\"\r\n                  type=\"email\"\r\n                  value={emailValue}\r\n                  {...register('email')}\r\n                  onChange={(e) => { setValue('email', e.target.value, { shouldValidate: true }); }}\r\n                  className=\"w-full\"\r\n                />\r\n                {errors.email && <p className=\"text-destructive text-sm mt-1\">{errors.email.message}</p>}\r\n              </div>\r\n\r\n              <div>\r\n                <Input\r\n                  id=\"website\"\r\n                  label=\"Website (optional)\"\r\n                  type=\"url\"\r\n                  value={websiteValue}\r\n                  {...register('website')}\r\n                  onChange={(e) => { setValue('website', e.target.value, { shouldValidate: true }); }}\r\n                  className=\"w-full\"\r\n                />\r\n                {errors.website && <p className=\"text-destructive text-sm mt-1\">{errors.website.message}</p>}\r\n              </div>\r\n\r\n              <div>\r\n                <label\r\n                  htmlFor=\"message\"\r\n                  className=\"block text-foreground dark:text-white text-sm md:text-base mb-2\"\r\n                >\r\n                  Message\r\n                </label>\r\n                <textarea\r\n                  id=\"message\"\r\n                  {...register('message')}\r\n                  rows={5}\r\n                  className=\"w-full px-5 py-4 bg-background dark:bg-black/20 border border-border dark:border-white/10 rounded-xl text-foreground dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-gold transition-all resize-none cursor-text text-left\"\r\n                  placeholder=\"Tell us about your needs...\"\r\n                />\r\n                {errors.message && <p className=\"text-destructive text-sm mt-1\">{errors.message.message}</p>}\r\n              </div>\r\n\r\n              <motion.button\r\n                type=\"submit\"\r\n                disabled={isSubmitting}\r\n                whileHover={{ scale: 1.02 }}\r\n                whileTap={{ scale: 0.98 }}\r\n                className=\"w-full sm:w-auto px-10 py-4 gradient-brand text-brand-dark rounded-2xl font-semibold text-lg shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2 disabled:opacity-50\"\r\n              >\r\n                {isSubmitting ? 'Sending...' : 'Submit'}\r\n                <Send className=\"w-5 h-5\" />\r\n              </motion.button>\r\n\r\n              <div aria-live=\"polite\" aria-atomic=\"true\" className=\"min-h-[1.5rem]\">\r\n                {submitStatus === 'success' && (\r\n                  <p className=\"text-brand-gold font-medium\">\r\n                    Message sent successfully! We'll be in touch soon.\r\n                  </p>\r\n                )}\r\n                {submitStatus === 'error' && (\r\n                  <p className=\"text-white/60 font-medium\">\r\n                    Something went wrong. Please try again.\r\n                  </p>\r\n                )}\r\n              </div>\r\n            </motion.form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\fredd\\Projects\\N-Npoultry\\src\\components\\sections\\ContactCTA.tsx","messages":[],"suppressedMessages":